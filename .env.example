# Copy to .env (gitignored) and fill in. Never commit .env.

# Supabase -> Connect -> Session pooler (port 5432), with your password filled in
DATABASE_URL=

# Supabase scheduler: fine-grained token for this repo only, "Actions: Read and write"
# (used once by scripts/setup_scheduler.py, which stores it in Supabase Vault)
GITHUB_DISPATCH_TOKEN=

# Optional: The Odds API key (licensed source)
ODDS_API_KEY=

# Optional collector settings (defaults shown)
# ODDS_SOURCES=action_network
# SPORTS=nba,nfl
# STATE_CODE=NJ
# DAYS_AHEAD_NBA=2
# DAYS_AHEAD_NFL=7
